        "Connecting to AgriSense real-time server..."
    );

    socket.on(
        "connect",
        function () {

            console.log(
                "Socket.IO connected successfully:",
                socket.id
            );

        }
    );





    // ============================================================
    // RECEIVE SENSOR DATA FROM NODE.JS
    // ============================================================

    socket.on(
        "sensorDataUpdated",
        function (sensor) {

            console.log(
                "REAL-TIME SENSOR UPDATE RECEIVED:"
            );

            console.log(sensor);


            if (!sensor) {
                return;
            }


            // ----------------------------------------------------
            // MOISTURE
            // ----------------------------------------------------

            updateSensorValue(
                "moistureValue",
                sensor.moisture
            );


            // ----------------------------------------------------
            // TEMPERATURE
            // ----------------------------------------------------

            updateSensorValue(
                "temperatureValue",
                sensor.temperature
            );


            // ----------------------------------------------------
            // PH
            // ----------------------------------------------------

            updateSensorValue(
                "phValue",
                sensor.pH
            );


            // ----------------------------------------------------
            // NITROGEN
            // ----------------------------------------------------

            updateSensorValue(
                "nitrogenValue",
                sensor.nitrogen
            );


            // ----------------------------------------------------
            // PHOSPHORUS
            // ----------------------------------------------------

            updateSensorValue(
                "phosphorusValue",
                sensor.phosphorus
            );


            // ----------------------------------------------------
            // POTASSIUM
            // ----------------------------------------------------

            updateSensorValue(
                "potassiumValue",
                sensor.potassium
            );

        }
    );


    // ============================================================
    // UPDATE HTML SENSOR VALUE
    // ============================================================

    function updateSensorValue(
        elementId,
        value
    ) {

        const element =
            document.getElementById(
                elementId
            );


        if (!element) {

            console.warn(
                "Sensor HTML element not found:",
                elementId
            );

            return;

        }


        if (
            value === null ||
            value === undefined
        ) {

            return;

        }


        element.textContent = value;

    }

